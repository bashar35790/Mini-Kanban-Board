# ── Database ────────────────────────────────────────────────────────────────
# Use Neon / Supabase / Render PostgreSQL connection string in production.
# For Neon: get both the pooled (DATABASE_URL) and direct (DIRECT_URL) URLs.
DATABASE_URL="postgresql://user:password@host:5432/kanban?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/kanban?schema=public"

# ── Better Auth ─────────────────────────────────────────────────────────────
# Generate a random 32+ char secret: `openssl rand -hex 32`
BETTER_AUTH_SECRET="replace-with-a-random-32-char-secret"

# Must match your Render service URL (no trailing slash)
BETTER_AUTH_URL="https://your-app-name.onrender.com"

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Your deployed Vercel frontend URL (no trailing slash)
FRONTEND_URL="https://your-app.vercel.app"
